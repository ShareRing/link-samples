{
  "name": "link-integration-backend",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build": "yarn run barrels && tsc --project tsconfig.compile.json",
    "barrels": "barrelsby --config .barrelsby.json",
    "start": "yarn run barrels && tsnd --inspect --exit-child --cls --ignore-watch node_modules --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
    "start:prod": "cross-env NODE_ENV=production node dist/index.js",
    "test:lint": "eslint '**/*.{ts,js}'",
    "test:lint:fix": "eslint '**/*.{ts,js}' --fix",
    "prettier": "prettier '**/*.{ts,js,json,md,yml,yaml}' --write"
  },
  "dependencies": {
    "@shareledgerjs/client": "^0.31.1-alpha8",
    "@tsed/ajv": "^7.30.0",
    "@tsed/common": "^7.30.0",
    "@tsed/core": "^7.30.0",
    "@tsed/di": "^7.30.0",
    "@tsed/exceptions": "^7.30.0",
    "@tsed/json-mapper": "^7.30.0",
    "@tsed/logger": "^6.7.5",
    "@tsed/logger-file": "^6.7.5",
    "@tsed/mongoose": "^7.30.0",
    "@tsed/openspec": "^7.30.0",
    "@tsed/platform-cache": "^7.30.0",
    "@tsed/platform-exceptions": "^7.30.0",
    "@tsed/platform-express": "^7.30.0",
    "@tsed/platform-log-middleware": "^7.30.0",
    "@tsed/platform-middlewares": "^7.30.0",
    "@tsed/platform-params": "^7.30.0",
    "@tsed/platform-response-filter": "^7.30.0",
    "@tsed/schema": "^7.30.0",
    "@tsed/swagger": "^7.30.0",
    "ajv": "^8.12.0",
    "axios": "^1.7.7",
    "bignumber.js": "^9.1.2",
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "dotenv-expand": "^12.0.1",
    "dotenv-flow": "^4.1.0",
    "express": "^4.18.2",
    "lodash": "^4.17.21",
    "merkletreejs": "^0.4.0",
    "method-override": "^3.0.0",
